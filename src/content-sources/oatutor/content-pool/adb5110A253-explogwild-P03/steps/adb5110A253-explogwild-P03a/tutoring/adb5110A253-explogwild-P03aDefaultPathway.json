            "adb5110A253-explogwild-P03a-h6"
        ],
        "title": "Solve for the growth rate",
        "text": "Use the fact that after $$3$$ hours 5,000 have heard the rumor to find $$r.$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "adb5110A253-explogwild-P03a-h8",
        "type": "hint",
        "dependencies": [
            "adb5110A253-explogwild-P03a-h7"
        ],
        "title": "Write an equation for $$r$$",
        "text": "$$5, 000=$$ $$\\frac{10,000}{1+1000\\cdot 10**{-3r}}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "adb5110A253-explogwild-P03a-h9",
        "type": "hint",
        "dependencies": [
            "adb5110A253-explogwild-P03a-h8"
        ],
        "title": "Multiply both sides by the denominator",
        "text": "$$5, 000=$$ $$\\frac{10,000}{1+1000\\cdot 10**{-3r}}$$ \\n\\n$$5000$$ $$\\left(1+1000\\cdot 10**{-3r}\\right)$$ $$=10, 000$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "adb5110A253-explogwild-P03a-h10",
        "type": "hint",
        "dependencies": [
            "adb5110A253-explogwild-P03a-h9"
        ],
        "title": "Divide both sides by 5,000",
        "text": "$$\\left(1+1000\\cdot 10**{-3r}\\right)$$ $$=2$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "adb5110A253-explogwild-P03a-h11",
        "type": "hint",
        "dependencies": [
            "adb5110A253-explogwild-P03a-h10"
        ],
        "title": "Isolate $$r$$ (more algebra)",
        "text": "$$1000$$ $$\\cdot$$ $${10}^{\\left(-3r\\right)}=1$$ \\n\\n$${10}^{\\left(-3r\\right)}=\\frac{1}{1000}$$ \\n\\n$$-3r=\\log_{10}\\left(\\frac{1}{1000}\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "adb5110A253-explogwild-P03a-h12",
        "type": "hint",
        "dependencies": [
            "adb5110A253-explogwild-P03a-h11"
        ],
        "title": "Apply law of logarithm",
        "text": "$$-3r=\\log_{10}\\left(\\frac{1}{1000}\\right)=\\log_{10}\\left(1\\right)-\\log_{10}\\left(1000\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "adb5110A253-explogwild-P03a-h13",
        "type": "hint",
        "dependencies": [
            "adb5110A253-explogwild-P03a-h12"
        ],
        "title": "Solve for $$r$$",
        "text": "This tells us that \\n $$3r=\\log_{10}\\left(1000\\right)=\\log_{10}\\left({10}^3\\right)=3$$, or $$r=1$$.",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "adb5110A253-explogwild-P03a-h14",
        "type": "hint",
        "dependencies": [
            "adb5110A253-explogwild-P03a-h13"
        ],
        "title": "Back to the problem",
        "text": "Now find $$t$$ so that $$N(t)=9, 000$$ given that $$r=1$$.",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "adb5110A253-explogwild-P03a-h15",
        "type": "hint",
        "dependencies": [
            "adb5110A253-explogwild-P03a-h14"
        ],
        "title": "Find the equation",
        "text": "Approximate to find $$t$$ \\n $$9, 000=$$ $$\\frac{10,000}{1+1000\\cdot 10**{-t}}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "adb5110A253-explogwild-P03a-h16",
        "type": "hint",
        "dependencies": [
            "adb5110A253-explogwild-P03a-h15"
        ],
        "title": "Solve for $$t$$",
        "text": "$$1000$$ $$(10**{-t})$$ $$=\\frac{1}{9}$$ \\n\\n$$\\frac{1000}{{10}^t}$$ $$=\\frac{1}{9}$$ \\n\\n$$9000={10}^t$$ \\n\\n$$t=\\log_{10}\\left(9000\\right)$$ $$\\approx$$ $$3.954$$",
        "variabilization": {},
