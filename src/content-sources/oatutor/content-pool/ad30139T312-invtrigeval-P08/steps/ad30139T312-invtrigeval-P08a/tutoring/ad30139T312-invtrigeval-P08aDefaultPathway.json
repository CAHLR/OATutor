        "dependencies": [
            "ad30139T312-invtrigeval-P08a-h2"
        ],
        "title": "Possible $$\\theta$$",
        "text": "Note that $$\\cos(\\theta)$$ <0 for pi/2< $$\\theta$$ $$\\leq$$ $$\\pi.$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "ad30139T312-invtrigeval-P08a-h4",
