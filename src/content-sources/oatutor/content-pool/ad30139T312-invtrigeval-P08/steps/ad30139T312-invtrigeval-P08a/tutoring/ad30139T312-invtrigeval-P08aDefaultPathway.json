        ],
        "title": "Definition of the cosine",
        "text": "$$\\arccos(-\\sqrt{2}/2)=\\theta$$ if and only if $$\\cos(\\theta)$$ $$=\\frac{\\left(-\\sqrt{2}\\right)}{2}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
