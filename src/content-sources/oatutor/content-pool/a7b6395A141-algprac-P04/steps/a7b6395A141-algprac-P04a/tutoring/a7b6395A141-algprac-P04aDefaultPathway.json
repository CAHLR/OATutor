        ],
        "title": "Least common denominator",
        "text": "Observe that the least common denominator is $$\\left(x-3\\right) \\left(x+3\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a7b6395A141-algprac-P04a-h4",
        "type": "hint",
        "dependencies": [
            "a7b6395A141-algprac-P04a-h3"
        ],
        "title": "Write with common denominator",
        "text": "$$\\frac{3x}{\\left(x-3\\right) \\left(x+3\\right)}+\\frac{1}{x-3} \\frac{x+3}{x+3}=\\frac{2}{x+3} \\frac{x-3}{x-3}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a7b6395A141-algprac-P04a-h5",
        "type": "hint",
        "dependencies": [
            "a7b6395A141-algprac-P04a-h4"
        ],
        "title": "Combine terms",
        "text": "$$\\frac{3x+x+3}{\\left(x-3\\right) \\left(x+3\\right)}=\\frac{2\\left(x-3\\right)}{\\left(x-3\\right) \\left(x+3\\right)}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a7b6395A141-algprac-P04a-h6",
        "type": "hint",
        "dependencies": [
            "a7b6395A141-algprac-P04a-h5"
        ],
        "title": "Move all terms to LHS",
        "text": "$$\\frac{3x+x+3-2\\left(x-3\\right)}{\\left(x-3\\right) \\left(x+3\\right)}=\\frac{2x+9}{\\left(x-3\\right) \\left(x+3\\right)}=0$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
