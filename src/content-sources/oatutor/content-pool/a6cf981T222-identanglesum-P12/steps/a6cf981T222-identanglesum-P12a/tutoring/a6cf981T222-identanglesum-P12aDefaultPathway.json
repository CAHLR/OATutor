    {
        "id": "a6cf981T222-identanglesum-P12a-h2",
        "type": "hint",
        "dependencies": [
            "a6cf981T222-identanglesum-P12a-h1"
        ],
        "title": "Relate to known angles",
        "text": "Note that $$\\frac{\\pi}{6}+\\frac{\\pi}{4}=\\frac{2\\pi}{12}+\\frac{3\\pi}{12}=\\frac{5\\pi}{12}.$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6cf981T222-identanglesum-P12a-h3",
        "type": "hint",
        "dependencies": [
            "a6cf981T222-identanglesum-P12a-h2"
        ],
        "title": "Substitute",
        "text": "$$\\sin\\left(\\frac{5\\pi}{12}\\right)=\\sin\\left(\\frac{\\pi}{6}+\\frac{\\pi}{4}\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6cf981T222-identanglesum-P12a-h4",
        "type": "hint",
        "dependencies": [
            "a6cf981T222-identanglesum-P12a-h3"
        ],
        "title": "Angle sum formula",
        "text": "Recall that $$\\sin(a+b)=\\sin(a)\\cos(b)+\\cos(a)\\sin(b).$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6cf981T222-identanglesum-P12a-h5",
        "type": "hint",
        "dependencies": [
            "a6cf981T222-identanglesum-P12a-h4"
        ],
        "title": "Apply the angle sum formula",
        "text": "$$\\sin\\left(\\frac{\\pi}{6}+\\frac{\\pi}{4}\\right)=\\sin\\left(\\frac{\\pi}{6}\\right)\\cos\\left(\\frac{\\pi}{4}\\right)+\\cos\\left(\\frac{\\pi}{6}\\right)\\sin\\left(\\frac{\\pi}{4}\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6cf981T222-identanglesum-P12a-h6",
        "type": "hint",
        "dependencies": [
            "a6cf981T222-identanglesum-P12a-h5"
        ],
        "title": "Substitute known special values",
        "text": "$$\\sin\\left(\\frac{\\pi}{6}\\right)\\cos\\left(\\frac{\\pi}{4}\\right)+\\cos\\left(\\frac{\\pi}{6}\\right)\\sin\\left(\\frac{\\pi}{4}\\right)=\\frac{1}{2}\\left(\\frac{1}{\\sqrt{2}}\\right)+\\frac{\\sqrt{3}}{2}\\left(\\frac{1}{\\sqrt{2}}\\right)=\\frac{1+\\sqrt{3}}{2\\sqrt{2}}$$",
