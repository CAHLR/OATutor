        ],
        "title": "Isolate $$n$$",
        "text": "$$\\log_{1.02}\\left({1.02}^n\\right)=\\log_{1.02}\\left(\\frac{95}{85}\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
