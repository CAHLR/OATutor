        ],
        "title": "Apply the law of logarithms for quotients",
        "text": "$$\\log_{10}\\!\\left(\\dfrac{x}{10}\\right)=\\log_{10}(x)-\\log_{10}(10)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
