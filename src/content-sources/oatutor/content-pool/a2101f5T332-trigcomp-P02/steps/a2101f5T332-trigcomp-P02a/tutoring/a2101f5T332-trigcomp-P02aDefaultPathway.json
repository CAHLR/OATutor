        ],
        "title": "Find the hypotenuse of the right triangle",
        "text": "Use the pythagorean theorem Adj $$**2$$ + Opp $$**2$$ $$=$$ Hyp $$**2$$ to find the length of the hypotenuse.",
        "variabilization": {},
        "oer": "",
        "license": ""
