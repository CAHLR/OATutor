        ],
        "title": "Simplify Further",
        "text": "$$\\frac{\\sin(\\theta)}{\\cos**2(\\theta)}=\\tan(\\theta)\\sec(\\theta).$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
