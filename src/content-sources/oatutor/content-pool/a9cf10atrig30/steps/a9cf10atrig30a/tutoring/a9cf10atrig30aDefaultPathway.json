        "title": "Identity",
        "text": "$$\\sec(\\theta)=\\frac{1}{\\cos(\\theta)},\\quad \\tan(\\theta)=\\frac{\\sin(\\theta)}{\\cos(\\theta)},\\quad \\cot(\\theta)=\\frac{\\cos(\\theta)}{\\sin(\\theta)}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
