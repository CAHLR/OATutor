        ],
        "title": "Substitute",
        "text": "Substitute identities into $$\\frac{\\operatorname{sec}\\left(\\theta\\right)+tan\\left(\\theta\\right)}{\\operatorname{cot}\\left(\\theta\\right)+cos\\left(\\theta\\right)}$$.",
        "variabilization": {},
        "oer": "",
        "license": ""
