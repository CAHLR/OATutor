        "type": "hint",
        "dependencies": [
            "a9cf10atrig30a-h2"
        ],
        "title": "Factor",
        "text": "After substitution, factor to get ((1+sin(theta))/cos(theta))/(cos(theta)*(1+sin(theta))/sin(theta)).",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
