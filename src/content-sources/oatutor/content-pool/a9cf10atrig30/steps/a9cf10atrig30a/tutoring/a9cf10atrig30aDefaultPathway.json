        ],
        "title": "Simplify",
        "text": "Cancel $$1+sin\\left(\\theta\\right)$$ to get $$\\frac{\\sin(\\theta)}{\\cos**2(\\theta)}.$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
