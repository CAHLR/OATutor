    },
    {
        "id": "a6cf981T222-identanglesum-P03a-h5",
        "type": "hint",
        "dependencies": [
            "a6cf981T222-identanglesum-P03a-h4"
        ],
        "title": "Divide fractions",
        "text": "$$\\frac{\\frac{\\sin(3x)\\cos(x)-\\cos(3x)\\sin(x)}{\\cos(3x)\\cos(x)}}{\\frac{\\cos(3x)\\cos(x)+\\sin(3x)\\sin(x)}{\\cos(3x)\\cos(x)}}=\\frac{\\sin(3x)\\cos(x)-\\cos(3x)\\sin(x)}{\\cos(3x)\\cos(x)+\\sin(3x)\\sin(x)}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6cf981T222-identanglesum-P03a-h6",
        "type": "hint",
        "dependencies": [
            "a6cf981T222-identanglesum-P03a-h5"
        ],
        "title": "Trig angle sum formulas",
        "text": "$$\\sin(A-B)=\\sin(A)\\cos(B)-\\cos(A)\\sin(B)$$ \\n $$\\cos(A-B)=\\cos(A)\\cos(B)+\\sin(A)\\sin(B)$$ \\n here $$A=3x$$ and $$B=x$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
