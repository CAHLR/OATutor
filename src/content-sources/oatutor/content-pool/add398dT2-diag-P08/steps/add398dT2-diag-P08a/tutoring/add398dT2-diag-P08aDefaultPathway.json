        "title": "Find a sum or difference",
        "text": "How is $$\\frac{\\pi}{12}$$ related to $$\\frac{\\pi}{3}$$ and $$\\frac{\\pi}{4}$$?",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "add398dT2-diag-P08a-h2",
        "type": "hint",
        "dependencies": [
            "add398dT2-diag-P08a-h1"
        ],
        "title": "Related to known angles",
        "text": "Note that $$\\frac{\\pi}{3}-\\frac{\\pi}{4}=\\frac{4\\pi}{12}-\\frac{3\\pi}{12}=\\frac{\\pi}{12}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "add398dT2-diag-P08a-h3",
        "type": "hint",
        "dependencies": [
            "add398dT2-diag-P08a-h2"
        ],
        "title": "Substitute",
        "text": "$$\\cos\\left(\\frac{\\pi}{12}\\right)=\\cos\\left(\\frac{\\pi}{3}-\\frac{\\pi}{4}\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "add398dT2-diag-P08a-h4",
        "type": "hint",
        "dependencies": [
            "add398dT2-diag-P08a-h3"
        ],
        "title": "Angle difference formula",
        "text": "Recall that $$\\cos(a-b)=\\cos(a)\\cos(b)+\\sin(a)\\sin(b)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "add398dT2-diag-P08a-h5",
        "type": "hint",
        "dependencies": [
            "add398dT2-diag-P08a-h4"
        ],
        "title": "Apply the angle sum formula",
        "text": "$$\\cos\\left(\\frac{\\pi}{3}-\\frac{\\pi}{4}\\right)=\\cos\\left(\\frac{\\pi}{3}\\right)\\cos\\left(\\frac{\\pi}{4}\\right)+\\sin\\left(\\frac{\\pi}{3}\\right)\\sin\\left(\\frac{\\pi}{4}\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "add398dT2-diag-P08a-h6",
        "type": "hint",
        "dependencies": [
            "add398dT2-diag-P08a-h5"
        ],
        "title": "Substitute known special values",
        "text": "$$\\cos\\left(\\frac{\\pi}{3}\\right)\\cos\\left(\\frac{\\pi}{4}\\right)+\\sin\\left(\\frac{\\pi}{3}\\right)\\sin\\left(\\frac{\\pi}{4}\\right)=\\frac{1}{2}\\frac{1}{\\sqrt{2}}+\\frac{\\sqrt{3}}{2}\\frac{1}{\\sqrt{2}}=\\frac{1+\\sqrt{3}}{2\\sqrt{2}}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    }
