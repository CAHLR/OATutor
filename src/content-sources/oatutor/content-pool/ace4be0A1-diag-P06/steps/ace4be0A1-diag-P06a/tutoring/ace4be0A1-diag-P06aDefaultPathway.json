            "ace4be0A1-diag-P06a-h1"
        ],
        "title": "Cross Multiply",
        "text": "$$\\frac{x+1}{x-1}+\\frac{2x+1}{x+3}=\\frac{\\left(x+1\\right) \\left(x+3\\right)+\\left(2x+1\\right) \\left(x-1\\right)}{\\left(x-1\\right) \\left(x+3\\right)}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "ace4be0A1-diag-P06a-h3",
        "type": "hint",
        "dependencies": [
            "ace4be0A1-diag-P06a-h2"
        ],
        "title": "Apply FOIL to each term",
        "text": "$$\\frac{\\left(x+1\\right) \\left(x+3\\right)+\\left(2x+1\\right) \\left(x-1\\right)}{\\left(x-1\\right) \\left(x+3\\right)}=\\frac{x^2+3x+x+3+2x^2-2x+x-1}{x^2+3x-x-3}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
