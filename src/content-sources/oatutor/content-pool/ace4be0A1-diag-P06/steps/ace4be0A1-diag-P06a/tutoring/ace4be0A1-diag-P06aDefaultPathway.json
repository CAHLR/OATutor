        ],
        "title": "Combine like terms in paretheses",
        "text": "$$\\frac{x^2+3x+x+3+2x^2-2x+x-1}{x^2+3x-x-3}=\\frac{x^2+4x+3+2x^2-x-1}{x^2+2x-3}$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
