    {
        "id": "a19b4c7A251-simplifylogexpressions-P01a-h3",
        "type": "hint",
        "dependencies": [
            "a19b4c7A251-simplifylogexpressions-P01a-h2"
        ],
        "title": "Apply the laws of logarithms for quotients",
        "text": "Observe the negative sign! Apply the law of logarithms for quotients to combine these two terms into a single term: $$\\log_b(a)-\\log_b(c)=\\log_b(a/c)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a19b4c7A251-simplifylogexpressions-P01a-h4",
        "type": "hint",
        "dependencies": [
            "a19b4c7A251-simplifylogexpressions-P01a-h3"
        ],
        "title": "Apply the laws of logarithms for quotients",
        "text": "$$\\log_2\\left((x+1)**5\\right)-\\log_2\\left((x-2)**2\\right)=\\log_2\\left(\\frac{(x+1)**5}{(x-2)**2}\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a19b4c7A251-simplifylogexpressions-P01a-h5",
        "type": "hint",
        "dependencies": [
