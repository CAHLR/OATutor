    {
        "id": "a19b4c7A251-simplifylogexpressions-P01a-h2",
        "type": "hint",
        "dependencies": [
            "a19b4c7A251-simplifylogexpressions-P01a-h1"
        ],
        "title": "Apply laws of logarithms for powers",
        "text": "$$5\\log_2(x+1)-2\\log_2(x-2)=\\log_2\\left((x+1)**5\\right)-\\log_2\\left((x-2)**2\\right)$$",
        "variabilization": {},
        "oer": "",
        "license": ""
